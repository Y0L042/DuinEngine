options gen2

require strings public
require daslib/strings_boost public

typedef module_info = tuple<string; string; string>

struct PathResolution {
    resolved : bool
    info : module_info
}

def get_imgui_subdir(name : string) : string {
    if (name == "imgui_boost") {
        return "daslib"
    }
    elif (name == "imgui_commands") {
        return "commands"
    }
    elif (name == "imgui_document_model" || name == "imgui_text_find" || name == "imgui_text_flow" || name == "imgui_text_source_model") {
        return "text"
    }
    elif (name == "imgui_boost_runtime" || name == "imgui_boost_v2" || name == "imgui_colors" || name == "imgui_containers_builtin"
            || name == "imgui_docking_builtin" || name == "imgui_drawlist_builtin" || name == "imgui_enums" || name == "imgui_file_dialog"
            || name == "imgui_fonts" || name == "imgui_harness_lint" || name == "imgui_icons" || name == "imgui_id_builtin"
            || name == "imgui_layout_builtin" || name == "imgui_lint" || name == "imgui_live_core" || name == "imgui_scope_builtin"
            || name == "imgui_style_builtin" || name == "imgui_table_builtin" || name == "imgui_theme_daslang"
            || name == "imgui_widgets_builtin" || name == "imgui_window_constraints_builtin") {
        return "widgets"
    }
    return ""
}

def get_engine_module(req, path_to_engine : string) : PathResolution {
    var res : PathResolution
    res.resolved = true
    let imguiName = starts_with(req, "imgui/") ? slice(req, 6) : (req == "imgui_boost" ? req : "")
    let imguiSubdir = get_imgui_subdir(imguiName)
    if (imguiSubdir != "") {
        res.info = (imguiName, path_to_engine + "vendor/dasimgui/das/{imguiSubdir}/{imguiName}.das", "")
    }
    elif (req == "dn_application") {
        res.info = ("dn_application", path_to_engine + "src/Duin/Script/modules/moduleApplication/dn_application.das", "")
    }
    elif (req == "dn_window") {
        res.info = ("dn_window", path_to_engine + "src/Duin/Script/modules/moduleApplication/dn_window.das", "")
    }
    elif (req == "dn_camera") {
        res.info = ("dn_camera", path_to_engine + "src/Duin/Script/modules/moduleRenderer/dn_camera.das", "")
    }
    elif (req == "dn_gameobject") {
        res.info = ("dn_gameobject", path_to_engine + "src/Duin/Script/modules/moduleGameObject/dn_gameobject.das", "")
    }
    elif (req == "dn_gamestatemachine") {
        res.info = ("dn_gamestatemachine", path_to_engine + "src/Duin/Script/modules/moduleGameObject/dn_gamestatemachine.das", "")
    }
    elif (req == "dn_scenebuilder") {
        res.info = ("dn_scenebuilder", path_to_engine + "src/Duin/Script/modules/moduleECS/dn_scenebuilder.das", "")
    }
    elif (req == "dn_ecs") {
        res.info = ("dn_ecs", path_to_engine + "src/Duin/Script/modules/moduleECS/dn_ecs.das", "")
    }
    elif (req == "dn_pipeline") {
        res.info = ("dn_pipeline", path_to_engine + "src/Duin/Script/modules/moduleECS/dn_pipeline.das", "")
    }
    elif (req == "dn_ecs_boost") {
        res.info = ("dn_ecs_boost", path_to_engine + "src/Duin/Script/modules/moduleECS/dn_ecs_boost.das", "")
    }
    elif (req == "dn_ecs_components") {
        res.info = ("dn_ecs_components", path_to_engine + "src/Duin/Script/modules/moduleECS/dn_ecs_components.das", "")
    }
    elif (req == "dn_filesystem") {
        res.info = ("dn_filesystem", path_to_engine + "src/Duin/Script/modules/moduleIO/dn_filesystem.das", "")
    }
    elif (req == "flecs" || req == "flecs_boost") {
        res.info = ("flecs_boost", path_to_engine + "vendor/flecs-daslang/flecs_das/src/scripts/flecs_helpers.das", "")
    }
    elif (req == "dn_log") {
        res.info = ("dn_log", path_to_engine + "src/Duin/Script/modules/moduleDNLog/dn_log.das", "")
    }
    elif (req == "dn_input") {
        res.info = ("dn_input", path_to_engine + "src/Duin/Script/modules/moduleInput/dn_input.das", "")
    }
    elif (req == "dn_physics") {
        res.info = ("dn_physics", path_to_engine + "src/Duin/Script/modules/modulePhysics/dn_physics.das", "")
    }
    elif (req == "dn_uuid") {
        res.info = ("dn_uuid", path_to_engine + "src/Duin/Script/modules/moduleUUID/dn_uuid.das", "")
    }
    elif (req == "dn_assets") {
        res.info = ("dn_assets", path_to_engine + "src/Duin/Script/modules/moduleAssets/dn_assets.das", "")
    }
    elif (req == "tomlc17") {
        res.info = ("tomlc17", path_to_engine + "src/Duin/Script/modules/moduleTOML/tomlc17.das", "")
    }
    elif (req == "live/live_commands") {
        res.info = ("live_commands", path_to_engine + "vendor/daslang/modules/dasLiveHost/live/live_commands.das", "")
    }
    elif (req == "live/live_vars") {
        res.info = ("live_vars", path_to_engine + "vendor/daslang/modules/dasLiveHost/live/live_vars.das", "")
    }

// TODO Quick fix for JIT
    elif (req == "llvm/daslib/llvm_macro") {
        res.info = ("llvm_macro", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_macro.das", "")
    }
    elif (req == "llvm/daslib/llvm_boost") {
        res.info = ("llvm_boost", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_boost.das", "")
    }
    elif (req == "llvm/daslib/llvm_debug") {
        res.info = ("llvm_debug", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_debug.das", "")
    }
    elif (req == "llvm/daslib/llvm_dll_utils") {
        res.info = ("llvm_dll_utils", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_dll_utils.das", "")
    }
    elif (req == "llvm/daslib/llvm_exe") {
        res.info = ("llvm_exe", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_exe.das", "")
    }
    elif (req == "llvm/daslib/llvm_jit") {
        res.info = ("llvm_jit", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_jit.das", "")
    }
    elif (req == "llvm/daslib/llvm_jit_cli") {
        res.info = ("llvm_jit_cli", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_jit_cli.das", "")
    }
    elif (req == "llvm/daslib/llvm_jit_common") {
        res.info = ("llvm_jit_common", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_jit_common.das", "")
    }
    elif (req == "llvm/daslib/llvm_jit_intrin") {
        res.info = ("llvm_jit_intrin", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_jit_intrin.das", "")
    }
    elif (req == "llvm/daslib/llvm_jit_run") {
        res.info = ("llvm_jit_run", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_jit_run.das", "")
    }
    elif (req == "llvm/daslib/llvm_targets") {
        res.info = ("llvm_targets", path_to_engine + "vendor/daslang/modules/dasLLVM/daslib/llvm_targets.das", "")
    }
    elif (req == "llvm/bindings/llvm_const") {
        res.info = ("llvm_const", path_to_engine + "vendor/daslang/modules/dasLLVM/bindings/llvm_const.das", "")
    }
    elif (req == "llvm/bindings/llvm_enum") {
        res.info = ("llvm_enum", path_to_engine + "vendor/daslang/modules/dasLLVM/bindings/llvm_enum.das", "")
    }
    elif (req == "llvm/bindings/llvm_func") {
        res.info = ("llvm_func", path_to_engine + "vendor/daslang/modules/dasLLVM/bindings/llvm_func.das", "")
    }
    elif (req == "llvm/bindings/llvm_struct") {
        res.info = ("llvm_struct", path_to_engine + "vendor/daslang/modules/dasLLVM/bindings/llvm_struct.das", "")
    }


    else {
        res.info = ("", "", "")
        res.resolved = false
    }
    return res
}


def module_default(req, from : string) : module_info {
    var frParts <- split_by_chars(from, "/\\")
    pop(frParts)  // strip filename, keep directory

    var reqParts <- split_by_chars(req, "/")
    let firstPart = reqParts[0]

    // Relative path require: ./foo or ../foo (handles explicit .das extension too)
    if (firstPart == "." || firstPart == "..") {
        for (part in reqParts) {
            if (part == "." || part == "") {
                continue
            } elif (part == "..") {
                if (length(frParts) > 0) {
                    pop(frParts)
                }
            } else {
                push(frParts, part)
            }
        }
        let lastComp = reqParts[length(reqParts) - 1]
        let modParts <- split_by_chars(lastComp, ".")
        let modName = modParts[0]
        let fullPath = join(frParts, "/")
        let hasDasExt = length(modParts) > 1
        return (modName, hasDasExt ? fullPath : fullPath + ".das", "")
    }

    // Module-name based require
    let rs <- split_by_chars(req, "./")
    let mod_name = rs[length(rs) - 1]
    if (length(rs) == 0) {
        return (mod_name, req + ".das", "")
    } elif (rs[0] == "daslib") {
        return (mod_name, "{get_das_root()}/daslib/{mod_name}.das", "")
    } elif (rs[0] == "dastest") {
        return (mod_name, "{get_das_root()}/dastest/{mod_name}.das", "")
    } else {
        for (se in rs) {
            push(frParts, se)
        }
        return (mod_name, join(frParts, "/") + ".das", "")
    }
}
